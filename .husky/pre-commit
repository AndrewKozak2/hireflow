(cd ui && npx lint-staged)
(cd api && npx lint-staged)

echo "🔍 Checking Swagger decorators..."

STAGED_API_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^api/.*\.(ts|tsx)$' || true)

if [ -z "$STAGED_API_FILES" ]; then
  echo "No TypeScript files in 'api/' staged. Skipping Swagger check."
  exit 0
fi

node api/scripts/check-swagger.js $STAGED_API_FILES