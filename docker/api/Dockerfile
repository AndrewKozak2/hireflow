FROM node:22-alpine AS builder

WORKDIR /app

ARG NODE_ENV
ARG PORT=3000
ARG DB_HOST
ARG DB_PORT
ARG DB_USER
ARG DB_PASSWORD
ARG DB_NAME
ARG JWT_ACCESS_SECRET
ARG JWT_REFRESH_SECRET
ARG EMAIL_PROVIDER
ARG RESEND_API_KEY
ARG RESEND_FROM_EMAIL
ARG BREVO_API_KEY
ARG EMAIL_FROM
ARG CORS_ALLOWED_ORIGINS

ENV NODE_ENV=$NODE_ENV
ENV PORT=$PORT
ENV DB_HOST=$DB_HOST
ENV DB_PORT=$DB_PORT
ENV DB_USER=$DB_USER
ENV DB_PASSWORD=$DB_PASSWORD
ENV DB_NAME=$DB_NAME
ENV JWT_ACCESS_SECRET=$JWT_ACCESS_SECRET
ENV JWT_REFRESH_SECRET=$JWT_REFRESH_SECRET
ENV EMAIL_PROVIDER=$EMAIL_PROVIDER
ENV RESEND_API_KEY=$RESEND_API_KEY
ENV RESEND_FROM_EMAIL=$RESEND_FROM_EMAIL
ENV BREVO_API_KEY=$BREVO_API_KEY
ENV EMAIL_FROM=$EMAIL_FROM
ENV CORS_ALLOWED_ORIGINS=$CORS_ALLOWED_ORIGINS

COPY api/package*.json ./
RUN npm ci

COPY api/ .
RUN npm run build

FROM node:22-alpine

WORKDIR /app

ARG NODE_ENV
ARG PORT=3000
ARG DB_HOST
ARG DB_PORT
ARG DB_USER
ARG DB_PASSWORD
ARG DB_NAME
ARG JWT_ACCESS_SECRET
ARG JWT_REFRESH_SECRET
ARG EMAIL_PROVIDER
ARG RESEND_API_KEY
ARG RESEND_FROM_EMAIL
ARG BREVO_API_KEY
ARG EMAIL_FROM
ARG CORS_ALLOWED_ORIGINS

ENV NODE_ENV=$NODE_ENV
ENV PORT=$PORT
ENV DB_HOST=$DB_HOST
ENV DB_PORT=$DB_PORT
ENV DB_USER=$DB_USER
ENV DB_PASSWORD=$DB_PASSWORD
ENV DB_NAME=$DB_NAME
ENV JWT_ACCESS_SECRET=$JWT_ACCESS_SECRET
ENV JWT_REFRESH_SECRET=$JWT_REFRESH_SECRET
ENV EMAIL_PROVIDER=$EMAIL_PROVIDER
ENV RESEND_API_KEY=$RESEND_API_KEY
ENV RESEND_FROM_EMAIL=$RESEND_FROM_EMAIL
ENV BREVO_API_KEY=$BREVO_API_KEY
ENV EMAIL_FROM=$EMAIL_FROM
ENV CORS_ALLOWED_ORIGINS=$CORS_ALLOWED_ORIGINS

COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package*.json ./

EXPOSE 3000

CMD ["node", "dist/src/main.js"]
