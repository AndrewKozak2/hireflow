# Template for $HIREFLOW_PROD_CONFIG/api.env (keep the real file OUTSIDE the
# repository). Values below are placeholders; never commit real secrets.

NODE_ENV=production
TZ=UTC

# Postgres.app on the host, separate database for production
DB_HOST=host.docker.internal
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=hireflow_prod

# Generate new ones for production: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me

# Public URLs
CLIENT_URL=https://hireflow.digital
CORS_ALLOWED_ORIGINS=https://hireflow.digital
CORS_ALLOW_ALL_IN_DEV=false

# Rate limiting stays on in production
THROTTLE_LIMIT=100
THROTTLE_TTL_MS=60000
AUTH_THROTTLE_LIMIT=5
AUTH_THROTTLE_TTL_MS=60000
REFRESH_THROTTLE_LIMIT=10
REFRESH_THROTTLE_TTL_MS=60000

# Email (Resend with a verified domain)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_change_me
RESEND_FROM_EMAIL="HireFlow <noreply@hireflow.digital>"
BREVO_API_KEY=unused
EMAIL_FROM=noreply@hireflow.digital

# File storage: the stack's MinIO, published as files.hireflow.digital so
# that presigned CV links open in any browser
AWS_REGION=us-east-1
AWS_S3_ENDPOINT=https://files.hireflow.digital
AWS_S3_BUCKET=hireflow-prod-uploads
AWS_ACCESS_KEY_ID=change-me          # = MINIO_ROOT_USER in minio.env
AWS_SECRET_ACCESS_KEY=change-me      # = MINIO_ROOT_PASSWORD in minio.env

# Email ingestion webhook (must match X_HIRE_FLOW_WEBHOOK_TOKEN in Apps Script)
HIREFLOW_WEBHOOK_TOKEN=change-me

# LLM
LLM_API_KEY=sk-ant-change-me
LLM_MODEL_LIGHT=claude-haiku-4-5-20251001
LLM_MODEL_HEAVY=claude-sonnet-4-6
LLM_TIMEOUT_MS=30000
LLM_RETRY_ATTEMPTS=3
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1000

SENTRY_DSN=
